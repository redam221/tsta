# TSTA Environment Configuration
# Copy this file to .env and fill in your values

# LLM API Configuration (OpenAI-compatible)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Alternative: 豆包 (Doubao) API
# OPENAI_API_KEY=your-doubao-key
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=your-endpoint-id

# Storage
TSTA_STORAGE_TYPE=json
TSTA_STORAGE_PATH=./data/trees

# Web
TSTA_HOST=127.0.0.1
TSTA_PORT=8000
